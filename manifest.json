      "extract_to": "bin/nginx",
      "entry": "nginx",
      "note": "解压后应得到 bin/nginx/nginx 可执行文件"
    },
    "php": {
      "version": "8.3.0",
      "license": "PHP License 3.01",
      "url": "https://github.com/Hjilin/mobileserver-bin-resources/releases/download/v1.0.0/php-8.3.0-arm64.zip",
      "sha256": "REPLACE_WITH_ACTUAL_SHA256_OF_php_ZIP",
      "extract_to": "bin/php",
      "entry": "php-cgi",
      "note": "解压后应得到 bin/php/php-cgi 可执行文件（CGI模式，配合Nginx fastcgi 9000端口）"
    },
    "mariadb": {
      "version": "11.4.2",
      "license": "GPL v2",
      "url": "https://github.com/Hjilin/mobileserver-bin-resources/releases/download/v1.0.0/mariadb-11.4.2-arm64.zip",
