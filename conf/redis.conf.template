# redis.conf 模板（本地单机版）
# 只监听本机，手机资源受限，关持久化/限内存

bind 127.0.0.1
port 6379
protected-mode yes
daemonize no

# 工作目录（APP data 目录）
dir ${DATA_DIR}

# 日志
logfile ${SERVER_ROOT}/logs/redis.log
loglevel notice

# 手机上不做持久化（可按需开启）
save ""
appendonly no

# 内存上限，避免占满手机
maxmemory 128mb
maxmemory-policy allkeys-lru
